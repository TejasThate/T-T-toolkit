# Database
DATABASE_URL=sqlite+aiosqlite:///./tandt.db
# For PostgreSQL on Render, use postgresql+asyncpg://user:pass@host/db

# Authentication
JWT_SECRET=your_jwt_secret_here

# Google OAuth (For Login and Gmail Sync)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Groq API (For LLM AI inference)
GROQ_API_KEY=your_groq_api_key_here

# --- Phase 3: Broker Integration ---
# Upstox API Credentials (Create an app at account.upstox.com/developer)
UPSTOX_API_KEY=your_upstox_api_key
UPSTOX_API_SECRET=your_upstox_api_secret
UPSTOX_REDIRECT_URI=http://localhost:8000/api/broker/callback_here

# Market Data Providers (Phase 1)
# Choose UPSTOX or ANGEL_ONE
MARKET_DATA_PROVIDER=MOCK
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
ANGEL_ONE_API_KEY=
ANGEL_ONE_CLIENT_CODE=
ANGEL_ONE_PASSWORD=
ANGEL_ONE_TOTP_SECRET=

# Redis (For WebSocket Pub/Sub and Caching)
# Leave blank to use in-memory fallback (only works for single-worker deployments)
REDIS_URL=redis://localhost:6379
